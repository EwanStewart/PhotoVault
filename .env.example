# Spotify API Credentials
# Get these from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here
SPOTIFY_REDIRECT_URI=http://localhost:5000/callback

# Phone uploads and the manage page
# Bind to the home network so the phone can reach the app. Leave unset to
# keep the app on the loopback address and the frame as the only client.
PHOTOVAULT_BIND_HOST=0.0.0.0
# Guards uploads, the manage page and every other write from the network.
# Requests from the Pi itself skip it, so the kiosk needs no PIN.
# With no PIN set, nothing off the Pi can write.
PHOTOVAULT_PIN=your_pin_here
